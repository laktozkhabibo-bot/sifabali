# ─── Host panel security ───
# Long random string (min. 32 chars). Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# First host password. Used ONCE (seed / first login) to create the bcrypt hash in the database.
# After that, change it from /hostpage → Güvenlik and you may delete this variable.
HOST_INITIAL_PASSWORD="ChangeMe-Strong-Password!"

# ─── Image uploads (Vercel Blob) ───
# Created automatically when you connect a Blob store in Vercel → Storage.
# If empty in local development, uploads are saved to /public/uploads instead.
BLOB_READ_WRITE_TOKEN=""

# ─── Public site URL (used for SEO, sitemap, Open Graph) ───
NEXT_PUBLIC_SITE_URL="https://www.sifabali.com"
